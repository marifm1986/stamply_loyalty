NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Exact public origin, no trailing slash. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SMS notifications (optional) ---
# Set to 1 to enable "your reward is ready" SMS when a stamp fills a card.
SMS_ENABLED=0
# Provider: "textbelt" (default, free 1/day with key "textbelt") or "twilio".
SMS_PROVIDER=textbelt
# TextBelt: leave as "textbelt" for the free test tier, or paste a paid key.
TEXTBELT_KEY=textbelt
# Twilio (used only when SMS_PROVIDER=twilio):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+
